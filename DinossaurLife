local function dinosaurIconFromText(value)
    local text = string.lower(tostring(value or ""))
    if string.find(text, "velociraptor", 1, true) or string.find(text, "raptor", 1, true) then return "🦎" end
    if string.find(text, "trex", 1, true) or string.find(text, "t-rex", 1, true) or string.find(text, "tyranno", 1, true) or string.find(text, "rex", 1, true) then return "🦖" end
    if string.find(text, "triceratops", 1, true) or string.find(text, "ceratops", 1, true) then return "🦏" end
    if string.find(text, "spino", 1, true) then return "🐊" end
    if string.find(text, "brachio", 1, true) or string.find(text, "sauropod", 1, true) or string.find(text, "bronto", 1, true) then return "🦕" end
    if string.find(text, "pteranodon", 1, true) or string.find(text, "pterodactyl", 1, true) then return "🦅" end
    if string.find(text, "carno", 1, true) then return "🐂" end
    if string.find(text, "dilo", 1, true) then return "🦎" end
    return "🦖"
end

local function getDinosaurType(player, character)
    if character then
        for _, name in ipairs({"DinosaurType", "DinoType", "Species", "Dinosaur", "Dino"}) do
            local value = character:GetAttribute(name)
            if value ~= nil and tostring(value) ~= "" then return tostring(value) end
        end
        local valueObject = character:FindFirstChild("DinosaurType") or character:FindFirstChild("DinoType") or character:FindFirstChild("Species")
        if valueObject and valueObject:IsA("StringValue") then return valueObject.Value end
    end
    if player then
        for _, name in ipairs({"DinosaurType", "DinoType", "Species", "Dinosaur", "Dino"}) do
            local value = player:GetAttribute(name)
            if value ~= nil and tostring(value) ~= "" then return tostring(value) end
        end
    end
    return character and character.Name or "Dinosaur"
end

local function getDinosaurIcon(player, character)
    return dinosaurIconFromText(getDinosaurType(player, character))
end

