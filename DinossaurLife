local corpseWords = {"corpse", "dead", "body", "carcass", "cadaver", "morto", "corpo"}
local meatWords = {"meat", "steak", "rawmeat", "raw_meat", "carne", "bife", "food", "fooditem"}

local function containsWord(name, words)
    local lower = string.lower(tostring(name))
    for _, word in ipairs(words) do
        if string.find(lower, word, 1, true) then return true end
    end
    return false
end

local function worldAdornee(object)
    if object:IsA("BasePart") then return object end
    if object:IsA("Model") then return object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true) end
    return nil
end

local function isCorpse(object)
    if not object:IsA("Model") then return false end
    if CollectionService:HasTag(object, "DinosaurCorpse") then return true end
    local humanoid = object:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then return true end
    return containsWord(object.Name, corpseWords)
end

local function isMeat(object)
    if CollectionService:HasTag(object, "DinosaurMeat") then return true end
    if object:IsA("Model") or object:IsA("BasePart") then return containsWord(object.Name, meatWords) end
    return false
end

