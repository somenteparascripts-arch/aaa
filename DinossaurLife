local function addVisualLog(eventName, details, color)
	local message = "[" .. eventName .. "]"

	if details and details.Message then
		message = message .. " " .. tostring(details.Message)
	end

	local label = create("TextLabel", {
		Size = UDim2.new(1, -4, 0, 22),
		BackgroundTransparency = 1,
		Text = message,
		TextColor3 = color or Theme.Text,
		Font = Enum.Font.Code,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = LogList,
	})

	table.insert(logEntries, {
		Event = eventName,
		Details = details or {},
		Label = label,
	})
end

local function clearLogs()
	for _, entry in ipairs(logEntries) do
		if entry.Label and entry.Label.Parent then
			entry.Label:Destroy()
		end
	end

	table.clear(logEntries)
	addVisualLog("LOG", {
		Message = "Log limpo.",
	}, Theme.Muted)
end

