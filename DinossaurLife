local function getPvPDesiredCFrame(targetRoot, mode, dt)
	local speed = Config.PvP.Speed
	local height = Config.PvP.Height
	local depth = Config.PvP.Depth
	local distance = Config.PvP.Distance

	local targetPosition = targetRoot.Position
	local targetCFrame = targetRoot.CFrame

	if mode == "MatarV1" then
		local position =
			targetPosition
			- targetCFrame.LookVector * distance
			+ targetCFrame.RightVector * depth
			+ Vector3.new(0, height, 0)

		return CFrame.lookAt(position, targetPosition)

	elseif mode == "MatarV2" then
		local radius = math.max(math.abs(distance), 0.25)
		Config.PvP.OrbitAngle += (dt * math.max(math.abs(speed), 0.1)) / radius

		local orbitOffset =
			targetCFrame.RightVector * math.cos(Config.PvP.OrbitAngle) * radius
			+ targetCFrame.LookVector * math.sin(Config.PvP.OrbitAngle) * radius
			+ targetCFrame.LookVector * depth
			+ Vector3.new(0, height, 0)

		local position = targetPosition + orbitOffset
		return CFrame.lookAt(position, targetPosition)

	elseif mode == "MatarV3" then
		local elapsed = os.clock() - Config.PvP.CycleStarted

		if elapsed >= 2 and not Config.PvP.Retreating then
			Config.PvP.Retreating = true
			Config.PvP.CycleStarted = os.clock()
		end

		if Config.PvP.Retreating then
			local retreatTime = os.clock() - Config.PvP.CycleStarted
			if retreatTime >= 1 then
				Config.PvP.Retreating = false
				Config.PvP.CycleStarted = os.clock()
			else
				local retreatDistance = math.max(math.abs(distance) * 8, 25)
				local position =
					targetPosition
					- targetCFrame.LookVector * retreatDistance
					+ targetCFrame.RightVector * depth
					+ Vector3.new(0, height, 0)

				return CFrame.lookAt(position, targetPosition)
			end
		end

		local position =
			targetPosition
			- targetCFrame.LookVector * distance
			+ targetCFrame.RightVector * depth
			+ Vector3.new(0, height, 0)

		return CFrame.lookAt(position, targetPosition)
	end

	return targetRoot.CFrame
end

local function stopPvP()
	pvpMoving = false
	pvpLocked = false
	local localRoot = getRoot(LocalPlayer.Character)
	if localRoot then
		localRoot.AssemblyLinearVelocity = Vector3.zero
	end
	Config.PvP.Retreating = false

	if pvpConnection then
		pvpConnection:Disconnect()
		pvpConnection = nil
	end

	PvPEnable.Text = "●  ATIVAR"
	PvPEnable.BackgroundColor3 = Theme.Button
	PvPEnable.TextColor3 = Theme.Muted
	PvPStatus.Text = "● DESATIVADO  •  Alvo: " ..
		(selectedPlayer and selectedPlayer.DisplayName or "Nenhum")
	PvPStatus.TextColor3 = Theme.Muted
	if hitboxVisualAdornment then
		hitboxVisualAdornment:Destroy()
		hitboxVisualAdornment = nil
	end
	clearHitboxV2Line()
end

local function startPvP()
	readPvPValues()

	local target = getPvPTarget()
	if not target then
		PvPStatus.Text = "● SELECIONE UM JOGADOR EM PLAYERS IN SERVER"
		PvPStatus.TextColor3 = Theme.Red
		return
	end

	if pvpConnection then
		pvpConnection:Disconnect()
	end

	pvpMoving = true
	pvpLocked = false
	Config.PvP.CycleStarted = os.clock()
	Config.PvP.Retreating = false

	PvPEnable.Text = "■  PARAR"
	PvPEnable.BackgroundColor3 = Theme.Red
	PvPEnable.TextColor3 = Theme.Text
	PvPStatus.Text = "● ATIVO  •  " .. Config.PvP.Mode ..
		"  •  Alvo: " .. target.DisplayName
	PvPStatus.TextColor3 = Theme.Green

	if Config.PvP.HitboxDebugEnabled then
		updateHitboxVisual()
	end

	pvpConnection = RunService.RenderStepped:Connect(function(dt)
		if not pvpMoving then
			return
		end

		local currentTarget = getPvPTarget()
		local localCharacter = LocalPlayer.Character
		local localRoot = getRoot(localCharacter)
		local targetCharacter = currentTarget and currentTarget.Character
		local targetRoot = getRoot(targetCharacter)

		if not currentTarget or not localRoot or not targetRoot then
			stopPvP()
			return
		end

		local desired = getPvPDesiredCFrame(
			targetRoot,
			Config.PvP.Mode,
			dt
		)

		local offset = desired.Position - localRoot.Position
		local distanceToDesired = offset.Magnitude

		-- Quando chega perto da posição de ataque, entra no modo LOCK.
		-- A partir daqui a movimentação passa a acompanhar a velocidade
		-- do alvo continuamente, para não ficar para trás em dinossauros rápidos.
		if not pvpLocked and distanceToDesired <= 2.5 then
			-- A captura termina aqui. A partir deste ponto não existe mais
			-- perseguição nem compensação pela velocidade do alvo.
			pvpLocked = true
			PvPStatus.Text = "● FIXADO  •  " .. Config.PvP.Mode ..
				"  •  Alvo: " .. currentTarget.DisplayName
			PvPStatus.TextColor3 = Theme.Green
		end

		local rawTargetVelocity = targetRoot.AssemblyLinearVelocity
		local targetHorizontalVelocity = Vector3.new(
			rawTargetVelocity.X,
			0,
			rawTargetVelocity.Z
		)

		if pvpLocked then
			-- LOCK ABSOLUTO:
			-- a perseguição termina assim que chegamos perto do alvo.
			-- Depois disso, a velocidade do alvo NÃO participa mais do cálculo.
			-- O personagem é colocado diretamente na posição do modo atual
			-- (costas/orbita/recuo) a cada frame, mantendo o offset fixo.
			local lockedCFrame = getPvPDesiredCFrame(
				targetRoot,
				Config.PvP.Mode,
				dt
			)

			localRoot.CFrame = lockedCFrame
			localRoot.AssemblyLinearVelocity = Vector3.zero
			localRoot.AssemblyAngularVelocity = Vector3.zero

			return
		end

		-- CAPTURA: mantém a velocidade dentro do limite seguro.
		local captureSpeed = math.max(
			math.abs(Config.PvP.CaptureSpeed),
			0.1
		)

		local safeTotalSpeed = math.max(
			5,
			math.abs(Config.PvP.ServerSafeSpeed or 44)
		)

		if distanceToDesired > 0.15 then
			local direction = offset.Unit

			local correctionSpeed = math.min(
				captureSpeed,
				math.max(4, distanceToDesired * 6)
			)

			local targetSpeed = targetHorizontalVelocity.Magnitude

			if targetSpeed > safeTotalSpeed then
				targetHorizontalVelocity =
					targetHorizontalVelocity.Unit * safeTotalSpeed
				targetSpeed = safeTotalSpeed
			end

			local remainingSpeed = math.sqrt(
				math.max(
					0,
					safeTotalSpeed * safeTotalSpeed
						- targetSpeed * targetSpeed
				)
			)

			correctionSpeed = math.min(
				correctionSpeed,
				remainingSpeed
			)

			local desiredVelocity =
				targetHorizontalVelocity
				+ direction * correctionSpeed

			if desiredVelocity.Magnitude > safeTotalSpeed then
				desiredVelocity =
					desiredVelocity.Unit * safeTotalSpeed
			end

			localRoot.AssemblyLinearVelocity =
				desiredVelocity
		else
			-- Pequena tolerância antes de entrar no LOCK.
			pvpLocked = true

			PvPStatus.Text = "● FIXADO  •  " .. Config.PvP.Mode ..
				"  •  Alvo: " .. currentTarget.DisplayName
			PvPStatus.TextColor3 = Theme.Green

			localRoot.AssemblyLinearVelocity =
				targetHorizontalVelocity
		end
	end)
end

