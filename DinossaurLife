local function refreshWorldESP()
	worldScanVersion += 1
	local scanVersion = worldScanVersion

	for object in pairs(worldESP) do
		removeWorldESP(object)
	end

	local count = 0

	for _, object in ipairs(workspace:GetDescendants()) do
		if scanVersion ~= worldScanVersion then
			return
		end

		local objectType = worldObjectType(object)

		if objectType then
			createWorldESP(object, objectType)
			count += 1
		end
	end

	WorldStatus.Text = "Objetos encontrados: " .. tostring(count)
end

