local function worldObjectType(object)
	local name = string.lower(object.Name)

	if CollectionService:HasTag(object, "DinosaurCorpse")
		or string.find(name, "corpse", 1, true)
		or string.find(name, "carcass", 1, true)
		or string.find(name, "cadaver", 1, true)
		or string.find(name, "dead", 1, true)
	then
		return "Corpse"
	end

	if CollectionService:HasTag(object, "DinosaurMeat")
		or string.find(name, "meat", 1, true)
		or string.find(name, "steak", 1, true)
		or string.find(name, "carne", 1, true)
	then
		return "Meat"
	end

	if CollectionService:HasTag(object, "DinosaurFood")
		or string.find(name, "food", 1, true)
		or string.find(name, "berry", 1, true)
		or string.find(name, "fruit", 1, true)
		or string.find(name, "comida", 1, true)
	then
		return "Food"
	end

	if CollectionService:HasTag(object, "DinosaurBone")
		or string.find(name, "bone", 1, true)
		or string.find(name, "osso", 1, true)
	then
		return "Bone"
	end

	return nil
end

local function worldAdornee(object)
	if object:IsA("BasePart") then
		return object
	end

	if object:IsA("Model") then
		return object.PrimaryPart
			or object:FindFirstChildWhichIsA("BasePart", true)
	end

	return nil
end

local function worldIcon(objectType)
	if objectType == "Meat" then
		return "🥩"
	elseif objectType == "Food" then
		return "🍖"
	elseif objectType == "Bone" or objectType == "Corpse" then
		return "🦴"
	end

	return "?"
end

local function shouldShowWorldType(objectType)
	if objectType == "Meat" then
		return Config.MeatESP
	elseif objectType == "Food" then
		return Config.FoodESP
	elseif objectType == "Bone" then
		return Config.BoneESP
	elseif objectType == "Corpse" then
		return Config.CorpseESP
	end

	return false
end

local function removeWorldESP(object)
	local data = worldESP[object]

	if data then
