local function create(className, properties)
	local object = Instance.new(className)

	for property, value in pairs(properties or {}) do
		pcall(function()
			object[property] = value
		end)
	end

	return object
end

local function addCorner(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
	return corner
end

local function addStroke(parent, color, thickness, transparency)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Theme.WhiteOutline
	stroke.Thickness = thickness or 1
	stroke.Transparency = transparency or 0.2
	stroke.Parent = parent
	return stroke
end

local function tween(object, properties, duration)
	local animation = TweenService:Create(
		object,
		TweenInfo.new(
			duration or 0.2,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		properties
	)

	animation:Play()
	return animation
end

local function getRoot(character)
	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
		or character.PrimaryPart
end

local function getHumanoid(character)
	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function getAdornee(character)
	if not character then
		return nil
	end

	return character:FindFirstChild("Head")
		or getRoot(character)
end

local function getDistance(player)
	local localRoot = getRoot(LocalPlayer.Character)
	local targetRoot = getRoot(player.Character)

	if not localRoot or not targetRoot then
		return math.huge
	end

	return (localRoot.Position - targetRoot.Position).Magnitude
end

local function formatDistance(distance)
	if distance == math.huge then
		return "--"
	end

	return string.format("%.1f", distance)
end

local function addLog(eventName, details)
	local entry = {
		Time = os.clock(),
		Event = eventName,
		Details = details or {},
	}

	table.insert(logEntries, entry)

	print(
		"[DinosaurVisualHub]",
		eventName,
		details and details.Message or ""
	)
end

local function isCarried()
	local character = LocalPlayer.Character

	if not character then
		return false
	end

	return character:GetAttribute("MovementState") == "Carried"
		or character:GetAttribute("ReplicatedMovementState") == "Carried"
		or character:GetAttribute("IsBeingCarried") == true
end

local function getDinosaurType(player, character)
	local names = {
		"DinosaurType",
		"DinoType",
		"Species",
		"Dinosaur",
		"Dino",
		"AnimalName",
	}

	if character then
		for _, attributeName in ipairs(names) do
			local value = character:GetAttribute(attributeName)

			if value ~= nil and tostring(value) ~= "" then
				return tostring(value)
			end
		end

		for _, objectName in ipairs(names) do
			local object = character:FindFirstChild(objectName)

			if object and object:IsA("StringValue") then
				return object.Value
			end
		end
	end

	if player then
		for _, attributeName in ipairs(names) do
			local value = player:GetAttribute(attributeName)

			if value ~= nil and tostring(value) ~= "" then
				return tostring(value)
			end
		end
	end

	return character and character.Name or "Dinosaur"
end

local function dinosaurIcon(value)
	local text = string.lower(tostring(value or ""))

	local icons = {
		{"velociraptor", "⚡"}, {"utahraptor", "⚡"}, {"deinonychus", "⚡"}, {"raptor", "⚡"},
		{"deinosuchus", "🐊"}, {"sarcosuchus", "🐊"},
		{"mosasaurus", "🦈"}, {"mosasaur", "🦈"}, {"shark", "🦈"}, {"megalodon", "🦈"},
		{"tyrannosaurus", "🦖"}, {"trex", "🦖"}, {"t-rex", "🦖"}, {"rex", "🦖"},
		{"giganotosaurus", "🦖"}, {"allosaurus", "🦖"}, {"carnotaurus", "🦖"}, {"ceratosaurus", "🦖"},
		{"spinosaurus", "🐊"}, {"spino", "🐊"}, {"suchomimus", "🐊"}, {"baryonyx", "🐊"},
		{"triceratops", "🦏"}, {"styracosaurus", "🦏"}, {"ceratops", "🦏"},
		{"brachiosaurus", "🦕"}, {"brachio", "🦕"}, {"brontosaurus", "🦕"}, {"diplodocus", "🦕"},
		{"stegosaurus", "🦕"}, {"ankylosaurus", "🦕"},
		{"iguanodon", "🦎"}, {"parasaurolophus", "🦎"}, {"hadrosaurus", "🦎"}, {"pachycephalosaurus", "🦎"},
		{"pteranodon", "🦅"}, {"pterodactyl", "🦅"}, {"quetzalcoatlus", "🦅"},
	}

	for _, pair in ipairs(icons) do
		if string.find(text, pair[1], 1, true) then
			return pair[2]
		end
	end

	return "🦖"
end

local function getPlayerIcon(player)
	return dinosaurIcon(
		getDinosaurType(
			player,
			player.Character
		)
	)
end

local function healthColor(percent)
	if percent > 0.7 then
		return Color3.fromRGB(65, 215, 105)
	elseif percent > 0.4 then
		return Color3.fromRGB(240, 190, 60)
	elseif percent > 0.2 then
		return Color3.fromRGB(240, 115, 50)
	end

	return Color3.fromRGB(235, 55, 65)
end

local function isLowHealth(humanoid)
	if not humanoid or humanoid.MaxHealth <= 0 then
		return false
	end

	return humanoid.Health / humanoid.MaxHealth <= Config.LowHealthLimit
end

