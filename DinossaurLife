local function rejoinServer()
	if not LocalPlayer or game.PlaceId <= 0 then
		return
	end

	Status.Text = "● REJOIN"
	Status.BackgroundColor3 = Theme.Blue
	Status.TextColor3 = Theme.Text

	addVisualLog("REJOIN", {
		Message = "Solicitando reconexão ao servidor...",
	}, Theme.Blue)

	local ok, err = pcall(function()
		TeleportService:Teleport(game.PlaceId, LocalPlayer)
	end)

	if not ok then
		Status.Text = "● ERRO"
		Status.BackgroundColor3 = Theme.Red
		Status.TextColor3 = Theme.Text

		addVisualLog("REJOIN_ERROR", {
			Message = tostring(err),
		}, Theme.Red)
	end
end

