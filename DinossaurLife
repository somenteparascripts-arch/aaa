local function healthColor(percent)
    if percent > 0.6 then return Color3.fromRGB(70, 220, 105) end
    if percent > 0.3 then return Color3.fromRGB(240, 185, 60) end
    return Color3.fromRGB(235, 65, 70)
end

local function removePlayerESP(player)
    local data = playerESP[player]
    if data then
        if data.Gui then data.Gui:Destroy() end
        if data.Highlight then data.Highlight:Destroy() end
        playerESP[player] = nil
    end
    if playerESPConnections[player] then
        for _, connection in pairs(playerESPConnections[player]) do pcall(function() connection:Disconnect() end) end
        playerESPConnections[player] = nil
    end
end

local function updatePlayerESP(player)
    local data = playerESP[player]
    if not data then return end
    local humanoid = data.Humanoid
    if not humanoid or not humanoid.Parent then removePlayerESP(player) return end
    local maxHealth = math.max(humanoid.MaxHealth, 1)
    local current = math.clamp(humanoid.Health, 0, maxHealth)
    local percent = current / maxHealth
    data.Icon.Text = getDinosaurIcon(player, humanoid.Parent)
    data.NameLabel.Text = player.DisplayName
    data.HealthText.Text = string.format("%d / %d", math.floor(current + 0.5), math.floor(maxHealth + 0.5))
    data.HealthBar.Size = UDim2.new(percent, 0, 1, 0)
    data.HealthBar.BackgroundColor3 = healthColor(percent)
    data.Gui.Enabled = CONFIG.PlayerESP
    data.NameLabel.Visible = CONFIG.PlayerNames
    data.HealthBack.Visible = CONFIG.HealthESP
    data.HealthText.Visible = CONFIG.HealthESP
    if data.Highlight then data.Highlight.Enabled = CONFIG.PlayerESP end
