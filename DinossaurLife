local function createToggle(parent, text, y, defaultValue, callback)
	local button = create("TextButton", {
		Size = UDim2.new(1, -32, 0, 35),
		Position = UDim2.fromOffset(16, y),
		BackgroundColor3 = defaultValue and Theme.ButtonHover or Theme.Button,
		BorderSizePixel = 0,
		Text = "",
		TextColor3 = Theme.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	})

	addCorner(button, 8)

	local enabled = defaultValue

	local function update()
		button.Text = (enabled and "●  " or "○  ") .. text
		button.TextColor3 = enabled and Theme.Text or Theme.Muted
		button.BackgroundColor3 = enabled
			and Theme.ButtonHover
			or Theme.Button
	end

	button.Activated:Connect(function()
		enabled = not enabled
		update()
		callback(enabled)
	end)

	update()

	return button
end

