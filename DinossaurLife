-- Atualização geral e saúde
local function updateLocalHealth()
	local character = LocalPlayer.Character
	local humanoid = getHumanoid(character)

	if not humanoid then
		return
	end

	local maxHealth = math.max(humanoid.MaxHealth, 1)
	local health = math.clamp(humanoid.Health, 0, maxHealth)
	local percent = health / maxHealth
	local color = healthColor(percent)

	LocalHealthFill.Size = UDim2.new(percent, 0, 1, 0)
	LocalHealthFill.BackgroundColor3 = color

	LocalHealthText.Text = string.format(
		"%d / %d",
		math.floor(health + 0.5),
		math.floor(maxHealth + 0.5)
	)

	if Config.AntiGrab then
		if isCarried() then
			GrabState.Text = "● MovementState: Carried"
			GrabState.TextColor3 = Theme.Red
		else
			GrabState.Text = "● MovementState: normal"
			GrabState.TextColor3 = Theme.Muted
		end
	end
end

local function updateHomeStats()
	local playerCount = #Players:GetPlayers()
	local worldCount = 0

	for _ in pairs(worldESP) do
		worldCount += 1
	end

	HomeStats.Text = string.format(
		"PLAYERS ONLINE     %d\nWORLD OBJECTS      %d\nALLIES              %d\nSELECTED TARGET     %s\n\nESP STATUS          %s",
		playerCount,
		worldCount,
		(function()
			local count = 0

			for _ in pairs(allies) do
				count += 1
			end

			return count
		end)(),
		selectedPlayer and selectedPlayer.DisplayName or "Nenhum",
		Config.PlayerESP and "ATIVO" or "DESATIVADO"
	)
end

