-- Player / Fuga runtime
local function updatePlayerController()
	local character = LocalPlayer.Character
	local humanoid = getHumanoid(character)
	local root = getRoot(character)
	if not humanoid or not root then
		return
	end

	-- IMPORTANTE: quando nenhum recurso do Player está ativo, não tocamos
	-- no Humanoid nem na física. Isso deixa o controlador original do jogo
	-- totalmente responsável por caminhar/correr e evita animação de corrida parada.
	if not Config.Player.WalkSpeedEnabled
		and not Config.Player.JumpPowerEnabled
		and not Config.Player.Fly
	then
		return
	end

	if pvpMoving or fugaWasActive then
		return
	end

	-- WalkSpeed e JumpPower só são mantidos enquanto seus respectivos
	-- controles estão ativos. A aplicação ocorre quando o usuário alterna
	-- o recurso, não a cada frame.
	if Config.Player.WalkSpeedEnabled then
		humanoid.WalkSpeed = Config.Player.WalkSpeed
	end

	if Config.Player.JumpPowerEnabled then
		pcall(function() humanoid.UseJumpPower = true end)
		humanoid.JumpPower = Config.Player.JumpPower
	end

	if not Config.Player.Fly then
		return
	end

	local flySpeed = math.max(Config.Player.FlySpeed, 0)
	local moveDirection = humanoid.MoveDirection
	local horizontal = Vector3.new(moveDirection.X, 0, moveDirection.Z)
	local hasHorizontalInput = horizontal.Magnitude > 0.01

	if hasHorizontalInput then
		horizontal = horizontal.Unit * flySpeed
	else
		horizontal = Vector3.zero
	end

	local vertical = 0
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		vertical = flySpeed
	elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
		vertical = -flySpeed
	end

	-- Só controlamos a física quando o usuário realmente está usando o Fly.
	-- Sem entrada, mantemos apenas a componente vertical natural do personagem.
	if hasHorizontalInput or vertical ~= 0 then
		root.AssemblyLinearVelocity = Vector3.new(horizontal.X, vertical, horizontal.Z)
	end
end

local function updateFuga()
	local character = LocalPlayer.Character
	local humanoid = getHumanoid(character)
	local root = getRoot(character)
	if not humanoid or not root then
		return
	end

	if pvpMoving then
		return
	end

	local lowHealth = humanoid.MaxHealth > 0
		and (humanoid.Health / humanoid.MaxHealth) <= Config.Fuga.Threshold

	if Config.Fuga.Enabled and lowHealth and not fugaWasActive then
		fugaWasActive = true
		fugaTargetY = root.Position.Y + Config.Fuga.DownOffset
		GrabState.Text = "● Fuga ativa: -50"
		GrabState.TextColor3 = Theme.Red
	end

	if fugaWasActive and Config.Fuga.Enabled and fugaTargetY then
		local deltaY = fugaTargetY - root.Position.Y
		if math.abs(deltaY) > 1 then
			root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(deltaY * 3, -80, 80), 0)
		else
			root.AssemblyLinearVelocity = Vector3.zero
		end
	elseif fugaReleasing and not Config.Fuga.Enabled and fugaReleaseTargetY then
		local deltaY = fugaReleaseTargetY - root.Position.Y
		if deltaY > 1 then
			root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(deltaY * 3, 0, 100), 0)
		else
			root.AssemblyLinearVelocity = Vector3.zero
			fugaReleasing = false
			fugaReleaseTargetY = nil
			GrabState.Text = "● Fuga desativada"
			GrabState.TextColor3 = Theme.Muted
		end
	end
end

