-- ESP de jogadores
local function removePlayerESP(player)
	local data = playerESP[player]

	if data then
		if data.Gui then
			data.Gui:Destroy()
		end

		if data.Highlight then
			data.Highlight:Destroy()
		end

		playerESP[player] = nil
	end

	if characterConnections[player] then
		for _, connection in ipairs(characterConnections[player]) do
			if connection and connection.Connected then
				connection:Disconnect()
			end
		end

		characterConnections[player] = nil
	end
end

local function updatePlayerESP(player)
	local data = playerESP[player]

	if not data then
		return
	end

	local character = player.Character
	local humanoid = getHumanoid(character)

	if not character or not humanoid or not humanoid.Parent then
		removePlayerESP(player)
		return
	end

	local maxHealth = math.max(humanoid.MaxHealth, 1)
	local health = math.clamp(humanoid.Health, 0, maxHealth)
	local percent = health / maxHealth
	local color = healthColor(percent)
	local ally = allies[player] == true

	data.Icon.Text = Config.PlayerIcons and getPlayerIcon(player) or ""
	data.NameLabel.Text = player.DisplayName
	data.HealthText.Text = string.format(
		"%d / %d",
		math.floor(health + 0.5),
		math.floor(maxHealth + 0.5)
	)

	data.HealthFill.Size = UDim2.new(percent, 0, 1, 0)
	data.HealthFill.BackgroundColor3 = color
	data.HealthBack.Visible = Config.PlayerHealth
	data.HealthText.Visible = Config.PlayerHealth
	data.NameLabel.Visible = Config.PlayerNames
	data.Icon.Visible = Config.PlayerIcons
	data.Gui.Enabled = Config.PlayerESP

	if data.Highlight then
