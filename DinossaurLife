local function stopMovement()
    movementMode = "None"
    orbitAngle = 0
    if movementConnection then movementConnection:Disconnect() movementConnection = nil end
    local root = getRoot(LocalPlayer.Character)
    local humanoid = getHumanoid(LocalPlayer.Character)
    if root then root.AssemblyLinearVelocity = Vector3.zero root.AssemblyAngularVelocity = Vector3.zero end
    if humanoid then humanoid.AutoRotate = true end
    Status.Text = "● STOPPED"
    Status.BackgroundColor3 = Color3.fromRGB(70, 40, 45)
end

local function startMovement(newMode)
    if not selectedPlayer then notify("Selecione um jogador primeiro.", CONFIG.Theme.Danger) return end
    local root = getRoot(LocalPlayer.Character)
    local targetRoot = getRoot(selectedPlayer.Character)
    local humanoid = getHumanoid(LocalPlayer.Character)
    if not root or not targetRoot then notify("Seu personagem ou o alvo não está pronto.", CONFIG.Theme.Danger) return end
    if movementConnection then movementConnection:Disconnect() end
    movementMode = newMode
    orbitAngle = 0
    if humanoid then humanoid.AutoRotate = false end
    Status.Text = newMode == "Orbit" and "● ORBIT" or "● COSTAS"
    Status.BackgroundColor3 = newMode == "Orbit" and Color3.fromRGB(35, 75, 120) or CONFIG.Theme.Purple

    movementConnection = RunService.Heartbeat:Connect(function(dt)
        if movementMode == "None" or not selectedPlayer or selectedPlayer.Parent ~= Players then stopMovement() return end
        local currentRoot = getRoot(LocalPlayer.Character)
        local currentTargetRoot = getRoot(selectedPlayer.Character)
        if not currentRoot or not currentTargetRoot then stopMovement() return end
        local targetPosition = currentTargetRoot.Position
        local radius = math.clamp(distance, CONFIG.DistanceMin, CONFIG.DistanceMax)
        local goal
        if movementMode == "Orbit" then
            orbitAngle += dt * CONFIG.OrbitSpeed * math.clamp(speed / 35, 0.05, 6)
            goal = targetPosition + Vector3.new(math.cos(orbitAngle) * radius, height, math.sin(orbitAngle) * radius)
        else
            goal = targetPosition - currentTargetRoot.CFrame.LookVector * radius + Vector3.new(0, height, 0)
        end
        local difference = goal - currentRoot.Position
        if difference.Magnitude > 0.05 then
            local step = math.min(difference.Magnitude, math.max(speed * dt, 0.01))
            local nextPosition = currentRoot.Position + difference.Unit * step
            currentRoot.CFrame = currentRoot.CFrame:Lerp(CFrame.new(nextPosition), math.clamp(dt * CONFIG.MovementSmoothness, 0, 1))
            currentRoot.AssemblyLinearVelocity = Vector3.zero
            currentRoot.AssemblyAngularVelocity = Vector3.zero
        end
        local look = targetPosition - currentRoot.Position
        if look.Magnitude > 0.01 then currentRoot.CFrame = currentRoot.CFrame:Lerp(CFrame.lookAt(currentRoot.Position, targetPosition), math.clamp(dt * 10, 0, 1)) end
    end)
end

local function teleportToTarget()
    if not selectedPlayer then notify("Selecione um jogador primeiro.", CONFIG.Theme.Danger) return end
    local root = getRoot(LocalPlayer.Character)
    local targetRoot = getRoot(selectedPlayer.Character)
    if not root or not targetRoot then notify("Alvo indisponível.", CONFIG.Theme.Danger) return end
    root.CFrame = targetRoot.CFrame * CFrame.new(0, height, distance)
    root.AssemblyLinearVelocity = Vector3.zero
    notify("Teleportado para perto de " .. selectedPlayer.DisplayName, CONFIG.Theme.Success)
end

